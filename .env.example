# Copy to .env (or set in your hosting) and fill in. Never commit the real values.

# Generate with: bin/rails secret
SECRET_KEY_BASE=

# Where the SQLite database lives in production
DATABASE_PATH=storage/production.sqlite3

# Your domain(s), comma separated. Requests for other hosts are blocked.
APP_HOST=example.com,www.example.com

RAILS_ENV=production
RAILS_LOG_LEVEL=info
PORT=3000
